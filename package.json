{
  "name": "ringside-booker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A wrestling promotion management sim that runs in the browser.",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "npm run dev -w @ringside/web",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "posttest": "npm run test:tz",
    "test:tz": "TZ=Pacific/Kiritimati vitest run --project engine test/core/calendar && TZ=America/St_Johns vitest run --project engine test/core/calendar",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-promise": "7.3.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "overrides": {
    "vite": "5.4.21"
  }
}
