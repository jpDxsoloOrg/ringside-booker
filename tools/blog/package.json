{
  "name": "@ringside/blog-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Checks and publishes the Ringside Booker blog series from docs/blog.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "tsx src/cli/check.ts",
    "journal:new": "tsx src/cli/journalNew.ts",
    "journal:due": "tsx src/cli/journalDue.ts",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "github-slugger": "2.0.0",
    "remark-gfm": "4.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "tsx": "4.23.15"
  }
}
