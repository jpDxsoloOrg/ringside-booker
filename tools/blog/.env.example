# Settings for the blog tools. Copy this file to tools/blog/.env.local (gitignored) and fill it in.
# See tools/blog/README.md.

# Publishing only. BLOG_DATABASE_URL is read from tools/blog/.env.local and nowhere else: not from
# the shell, not from CI. Use the direct (non-pooled) connection string; a pooled endpoint in
# transaction-pooling mode can break the publisher's multi-statement transaction.
BLOG_DATABASE_URL=
# The blog user new posts are credited to.
BLOG_AUTHOR_EMAIL=
# The blog's public origin, for example https://example.com
BLOG_SITE_URL=

# Optional. The defaults are shown; uncomment a line to change it.
# BLOG_REPO_URL=https://github.com/jpDxsoloOrg/ringside-booker
# BLOG_REPO_BRANCH=main
# BLOG_ASSET_BASE_URL=https://raw.githubusercontent.com/jpDxsoloOrg/ringside-booker/main/docs/blog/images
# The private banned-terms list (default ~/.config/ringside-booker/banned-terms.txt).
# BLOG_BANNED_TERMS_FILE=~/.config/ringside-booker/banned-terms.txt
