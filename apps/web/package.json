{
  "name": "@ringside/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Ringside Booker game UI.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "pree2e": "tsx e2e/fixtures/build-sample-save.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium webkit"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@ringside/engine": "*",
    "@tanstack/react-table": "9.3.1",
    "comlink": "4.4.2",
    "idb": "8.0.4",
    "lucide-react": "1.69.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "zod": "4.6.7",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@csstools/postcss-global-data": "4.0.0",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "jsdom": "26.1.0",
    "playwright-core": "1.65.0",
    "postcss-custom-media": "12.0.3",
    "tsx": "4.23.15",
    "vite": "5.4.21",
    "vitest": "3.2.7"
  }
}
