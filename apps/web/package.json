{
  "name": "@ringside/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Ringside Booker game UI.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
