/*
 * The game's runtime theme: Unity's default controls, then the Ringside Booker tokens and styles.
 * PanelSettings.asset uses it, so every UIDocument (title, shell) gets the same look. A feature's
 * own stylesheet can be imported here or added to its root element in code.
 */
@import url("unity-theme://default");
@import url("../Styles/Tokens.uss");
@import url("../Styles/Base.uss");
@import url("../Styles/Components.uss");
@import url("../Styles/Shell.uss");
@import url("../Styles/Title.uss");
@import url("../Screens/Screens.uss");
/* UNITY-11 design system: ds- tokens and components (the redesign's style guide and component set). */
@import url("../Design/DsTokens.uss");
@import url("../Design/DsComponents.uss");
@import url("../Design/DsShell.uss");
@import url("../Design/DsMockups.uss");
