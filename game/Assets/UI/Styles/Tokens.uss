/*
 * Design tokens, ported from the web app (apps/web/src/styles/tokens.css; the source of truth for
 * colour, type and shape is docs/design/visual-identity.md).
 *
 * USS has no rem, so sizes are px at the web's 16px root: --space-4 = 1rem = 16px. The UI scale
 * setting scales the whole panel (PanelSettings, see UiScale.cs), so text and spacing grow together
 * exactly as --ui-scale does on the web. Components use the semantic tokens (--color-*), never raw hex.
 */

:root {
    /* Canvas, surfaces and lines (navy neutrals). */
    --color-bg: #090d16;
    --color-surface: #0f172a;
    --color-surface-raised: #131d31;
    --color-surface-hover: #1a2740;
    --color-surface-sunken: #090d16;
    --color-border: #24334d;
    --color-border-strong: #3b4d6b;

    /* Text. --color-text-subtle is for large or decorative text only. */
    --color-text: #f1f5f9;
    --color-text-muted: #94a3b8;
    --color-text-subtle: #64748b;
    --color-text-inverse: #090d16;

    /* Accents: each hue has one job. Red-orange = act now / live; cyan = data; gold = prestige. */
    --color-action: #d7301a;
    --color-action-bright: #ff3b1d;
    --color-action-contrast: #ffffff;
    --color-data: #00e5ff;
    --color-prestige: #facc15;
    --color-positive: #34d399;
    --color-negative: #fb7185;
    --color-warning: #facc15;
    --color-focus: #00e5ff;
    --color-overlay: rgba(5, 8, 15, 0.7);

    /* Spacing: a 4px step. */
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 20px;
    --space-6: 24px;
    --space-8: 32px;
    --space-10: 40px;

    /* Shape. */
    --radius-card: 10px;
    --radius-control: 8px;
    --radius-pill: 999px;
    --radius-sm: 4px;

    /* Type scale. */
    --font-size-xs: 12px;
    --font-size-sm: 14px;
    --font-size-md: 16px;
    --font-size-lg: 18px;
    --font-size-xl: 22px;
    --font-size-2xl: 28px;
    --font-size-3xl: 36px;

    /*
     * Faces: Barlow Condensed for display (headings, labels, chips, stat numbers) and Inter for
     * body. USS picks a weight by font file, so the display classes in Base.uss name the file.
     */

    /* Layout sizes. */
    --sidebar-width: 240px;
    --topbar-height: 56px;
    --content-max-width: 2200px;

    /* Motion. */
    --motion-fast: 120ms;
    --motion-base: 200ms;

    /* The base text style every panel starts from. */
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-Regular.ttf");
    font-size: var(--font-size-md);
    color: var(--color-text);
}
