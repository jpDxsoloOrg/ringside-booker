/* The title screen: wordmark and main menu on the left, the chosen item's panel on the right. */

.title-screen {
    flex-grow: 1;
    flex-direction: row;
    background-color: var(--color-bg);
}

.title-side {
    width: 480px;
    min-width: 480px;
    justify-content: center;
    padding: var(--space-10) var(--space-10);
    border-right-width: 1px;
    border-right-color: var(--color-border);
    background-color: var(--color-surface);
}

.title-wordmark {
    flex-direction: row;
}

.title-wordmark__word {
    font-size: 56px;
    letter-spacing: 2px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/BarlowCondensed-ExtraBold.ttf");
    color: var(--color-text);
}

.title-wordmark__accent {
    margin-left: 12px;
    color: var(--color-action-bright);
}

.title-tagline {
    margin-top: var(--space-1);
    margin-bottom: var(--space-10);
    color: var(--color-text-muted);
    font-size: var(--font-size-md);
    white-space: normal;
}

.title-stripe {
    height: 3px;
    margin-bottom: var(--space-8);
}

.menu-button {
    flex-direction: row;
    justify-content: flex-start;
    min-height: 48px;
    margin: 0 0 var(--space-2) 0;
    padding: 0 var(--space-4);
    border-width: 1px;
    border-color: transparent;
    border-left-width: 3px;
    border-left-color: transparent;
    border-radius: 0;
    background-color: transparent;
    color: var(--color-text);
    font-size: var(--font-size-2xl);
    letter-spacing: 1.2px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/BarlowCondensed-Bold.ttf");
    -unity-text-align: middle-left;
    transition-property: background-color, border-color;
    transition-duration: 120ms;
}

.menu-button:hover {
    background-color: var(--color-surface-hover);
    border-color: transparent;
    border-left-color: var(--color-border-strong);
}

.menu-button:focus {
    border-color: var(--color-focus);
    border-left-color: var(--color-focus);
}

.menu-button--current {
    background-color: var(--color-surface-hover);
    border-left-color: var(--color-action-bright);
}

.menu-button--current:hover {
    border-left-color: var(--color-action-bright);
}

.title-version {
    position: absolute;
    left: var(--space-10);
    bottom: var(--space-6);
    color: var(--color-text-subtle);
    font-size: var(--font-size-xs);
}

.title-panel {
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: center;
    padding: var(--space-10);
}

.title-panel__inner {
    max-width: 760px;
}

/* The New game wizard (UNITY-13): top-aligned, as wide as the settings rows need, and the step
   scrolls inside the panel when it is taller than the window. */
.title-panel--wizard {
    justify-content: flex-start;
    padding-top: var(--space-8);
    padding-bottom: var(--space-6);
}

.title-panel__inner--wizard {
    max-width: 960px;
    flex-shrink: 1;
    min-height: 0;
}

.title-panel__inner--wizard > * {
    flex-shrink: 0;
}

.title-panel__inner--wizard > .rb-wizard {
    flex-shrink: 1;
    min-height: 0;
}

/* The title's Settings: the groups scroll inside the panel, and none of them squeezes (S13). */
.title-panel__inner--wizard > .title-settings-scroll {
    flex-shrink: 1;
    min-height: 0;
}

.title-settings-scroll .settings-group {
    flex-shrink: 0;
}
