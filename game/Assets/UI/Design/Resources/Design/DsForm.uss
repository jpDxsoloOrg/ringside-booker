/* The form kit (EVT8): text fields, number steppers, date fields, the recurrence builder and the
   upcoming-dates strip. Loaded by each component through DsForm.Style, so it works in overlays. */

.dsf-field {
    flex-shrink: 0;
    margin-top: 12px;
}

.dsf-label {
    margin-bottom: 4px;
    font-size: 11px;
    letter-spacing: 1.4px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/BarlowCondensed-Bold.ttf");
    color: var(--ds-text-3);
}

.dsf-caption {
    margin: 6px 0 4px 0;
    font-size: 12px;
    color: var(--ds-text-3);
}

.dsf-hint {
    margin-top: 3px;
    font-size: 12px;
    color: var(--ds-text-4);
    white-space: normal;
}

.dsf-error {
    margin-top: 3px;
    font-size: 12px;
    color: var(--ds-bad);
    white-space: normal;
}

.dsf-input {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 32px;
    padding-left: 4px;
    border-width: 1px;
    border-color: var(--ds-line-strong);
    border-radius: var(--ds-radius-sm);
    background-color: var(--ds-elev-0);
}

.dsf-field--error .dsf-input,
.dsf-field--error .dsf-stepper__input {
    border-color: var(--ds-bad);
}

.dsf-input__field {
    flex-grow: 1;
    margin: 0;
}

.dsf-input__field > .unity-base-text-field__input,
.dsf-stepper__input > .unity-base-text-field__input {
    margin: 0;
    padding: 0 8px;
    border-width: 0;
    background-color: transparent;
    font-size: 13px;
    color: var(--ds-text);
}

.dsf-date__box {
    width: 220px;
}

.dsf-date__icon {
    margin-left: 4px;
    color: var(--ds-text-3);
}

.dsf-stepper__row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.dsf-stepper__button {
    flex-shrink: 0;
}

.dsf-stepper__input {
    width: 56px;
    height: 32px;
    margin: 0 6px;
    border-width: 1px;
    border-color: var(--ds-line-strong);
    border-radius: var(--ds-radius-sm);
    background-color: var(--ds-elev-0);
}

.dsf-stepper__input > .unity-base-text-field__input {
    -unity-text-align: middle-center;
}

.dsf-chips {
    flex-shrink: 0;
}

.dsf-chips > .ds-chip {
    margin: 0 6px 6px 0;
}

.dsf-recurrence__fields {
    flex-shrink: 0;
    margin-top: 6px;
}

.dsf-upcoming {
    flex-shrink: 0;
    margin-top: 10px;
    padding: 10px 12px;
    border-width: 1px;
    border-color: var(--ds-line);
    border-radius: var(--ds-radius-md);
    background-color: var(--ds-elev-1);
}

.dsf-upcoming--loading {
    opacity: 0.6;
}

.dsf-upcoming__head {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 6px;
}

.dsf-upcoming__icon {
    margin-right: 6px;
    color: var(--ds-data);
}

.dsf-upcoming__summary {
    flex-shrink: 1;
    font-size: 13px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold.ttf");
    color: var(--ds-text);
    white-space: normal;
}

.dsf-upcoming__dates {
    flex-shrink: 0;
}

.dsf-date-chip {
    flex-shrink: 0;
    margin: 0 6px 4px 0;
    padding: 2px 8px;
    border-radius: var(--ds-radius-pill);
    background-color: var(--ds-data-soft);
    font-size: 12px;
    color: var(--ds-data);
}
