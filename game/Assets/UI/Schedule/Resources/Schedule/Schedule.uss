/* The schedule editor's sheets (EVT8): New recurring show, One-off special, Manage shows, Retire.
   Loaded with ScheduleEditor.Style; sc- classes. */

.sc-editor,
.sc-manage,
.sc-retire {
    flex-shrink: 0;
}

.sc-lead {
    flex-shrink: 0;
    margin-bottom: 4px;
    font-size: 13px;
    color: var(--ds-text-2);
    white-space: normal;
}

.sc-slot {
    flex-shrink: 0;
}

.sc-pair {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
}

.sc-pair > .dsf-field {
    margin-right: 24px;
}

.sc-picker {
    align-self: flex-start;
    min-width: 240px;
    max-width: 100%;
}

.sc-more-toggle {
    align-self: flex-start;
    flex-shrink: 0;
    margin-top: 14px;
}

.sc-more {
    flex-shrink: 0;
    padding-left: 12px;
    border-left-width: 2px;
    border-left-color: var(--ds-line);
}

.sc-switch {
    height: auto;
    min-height: 34px;
    margin-top: 12px;
    padding: 4px 6px;
    align-items: flex-start;
    flex-shrink: 0;
}

.sc-switch .ds-check__box {
    margin-top: 2px;
}

.sc-switch__words {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 10px;
}

.sc-switch__label {
    margin-left: 0;
    -unity-text-align: middle-left;
}

.sc-switch__hint {
    margin-top: 1px;
    font-size: 12px;
    color: var(--ds-text-4);
    -unity-text-align: middle-left;
    white-space: normal;
}

.sc-notice {
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
    margin-top: 8px;
    padding: 8px 10px;
    border-radius: var(--ds-radius-sm);
    background-color: var(--ds-state-soft);
}

.sc-notice__icon {
    margin-right: 8px;
    color: var(--ds-state);
}

.sc-notice__text {
    flex-shrink: 1;
    font-size: 13px;
    color: var(--ds-text);
    white-space: normal;
}

.sc-warnings,
.sc-problems {
    flex-shrink: 0;
}

.sc-changes {
    flex-shrink: 0;
    margin-top: 16px;
}

.sc-change {
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
    margin-top: 8px;
}

.sc-change__icon {
    margin: 2px 8px 0 0;
    color: var(--ds-state);
}

.sc-change__words {
    flex-shrink: 1;
}

.sc-change__title {
    font-size: 13px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold.ttf");
    color: var(--ds-text);
}

.sc-change__detail {
    margin-top: 1px;
    font-size: 12px;
    color: var(--ds-text-3);
    white-space: normal;
}

.sc-kept {
    flex-shrink: 0;
    margin: 4px 0 0 24px;
}

.sc-kept__row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 30px;
    border-bottom-width: 1px;
    border-bottom-color: var(--ds-line-subtle);
}

.sc-kept__date {
    width: 84px;
    flex-shrink: 0;
    font-size: 12px;
    color: var(--ds-text-2);
}

.sc-kept__name {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 8px;
    font-size: 13px;
    color: var(--ds-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    letter-spacing: 0;
}

.sc-date-list {
    flex-shrink: 0;
    font-size: 13px;
    color: var(--ds-text-2);
    white-space: normal;
}

.sc-saved {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin: 8px 0 8px 0;
}

.sc-saved__icon {
    margin-right: 12px;
    color: var(--ds-good);
}

.sc-saved__words {
    flex-shrink: 1;
}

.sc-saved__title {
    font-size: 18px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-Bold.ttf");
    color: var(--ds-text);
    white-space: normal;
}

.sc-footer {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
}

.sc-footer > .ds-btn {
    margin-left: 8px;
}

.sc-menu {
    width: 340px;
    padding: 6px;
}

.sc-menu__item {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin: 0;
    padding: 8px 10px;
    border-width: 0;
    border-radius: var(--ds-radius-sm);
    background-color: transparent;
}

.sc-menu__item:hover,
.sc-menu__item:focus {
    background-color: var(--ds-elev-3);
}

.sc-menu__icon {
    margin-right: 12px;
    color: var(--ds-data);
}

.sc-menu__words {
    flex-shrink: 1;
}

.sc-menu__title {
    font-size: 14px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold.ttf");
    color: var(--ds-text);
    -unity-text-align: middle-left;
}

.sc-menu__detail {
    margin-top: 1px;
    font-size: 12px;
    color: var(--ds-text-3);
    -unity-text-align: middle-left;
    white-space: normal;
}

.sc-show-cell,
.sc-size-cell {
    flex-shrink: 1;
    overflow: hidden;
}

.sc-show-cell__name {
    font-size: 13px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold.ttf");
    color: var(--ds-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    letter-spacing: 0;
}

.sc-show-cell__brand {
    font-size: 11px;
    color: var(--ds-text-3);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    letter-spacing: 0;
}

.sc-cell {
    font-size: 13px;
    color: var(--ds-text-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    letter-spacing: 0;
}

.sc-actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.sc-actions > .ds-btn {
    margin-right: 4px;
}

.sc-modal {
    width: 560px;
    max-height: 90%;
}

.sc-modal__scroll {
    flex-shrink: 1;
}

.sc-toolbar-actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 8px;
}

.sc-toolbar-actions > .ds-btn {
    margin-left: 8px;
}

/* UNITY-40: Manage shows' Next column when a show is not on the calendar. */
.sc-cell--quiet {
    color: var(--ds-text-3);
}

.sc-cell--warn {
    color: var(--ds-warn);
}

.sc-notice__action {
    flex-shrink: 0;
    margin-left: auto;
    align-self: center;
}
