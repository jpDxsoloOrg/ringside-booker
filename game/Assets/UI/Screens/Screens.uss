/*
 * The core loop screens (UNITY-09): Office, Roster, Calendar, Booking, Show night, Results, the
 * segment editor and the New game wizard. PC-game density at the 1920×1080 reference: 14 px body
 * text, 28-32 px table rows, tight padding.
 */

.rb-screen { flex-direction: column; font-size: 14px; }
.rb-screen > .screen-heading { font-size: 26px; margin-bottom: 4px; }
.rb-subtitle { margin-bottom: 10px; }
.rb-note { color: var(--color-text-muted); font-size: 13px; white-space: normal; }
.rb-error { color: var(--color-negative); font-size: 13px; white-space: normal; margin: 4px 0; }
.rb-warning { color: var(--color-warning); }
.rb-gap-top { margin-top: 10px; }
.rb-spacer { flex-grow: 1; }
.rb-stack { flex-direction: column; }

.rb-row { flex-direction: row; align-items: center; flex-wrap: wrap; }
.rb-row > * { margin-right: 12px; }
.rb-row--tight > * { margin-right: 6px; }
/* A tight row is one inline group (a number and its Why?, a value and its Set link): it never
   wraps; its text shrinks with an ellipsis instead. Add .rb-row--wrap for button groups. */
.rb-row--tight { flex-wrap: nowrap; }
.rb-row--tight > Button, .rb-row--tight > .rb-portrait, .rb-row--tight > .rb-logo { flex-shrink: 0; }
.rb-row--tight > .unity-label { flex-shrink: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
.rb-row--wrap { flex-wrap: wrap; }
.rb-columns { flex-direction: row; align-items: flex-start; }
.rb-column { flex-grow: 1; flex-basis: 0; flex-direction: column; margin-right: 12px; min-width: 260px; }
.rb-column--wide { flex-grow: 1.8; }
.rb-cell-stack { flex-direction: column; flex-shrink: 1; }

.rb-panel { padding: 10px 12px; margin-bottom: 12px; }
.rb-panel__title { margin-bottom: 6px; }
.rb-panel__body { flex-direction: column; }
.rb-panel__action { align-self: flex-start; margin-top: 8px; }
.rb-title {
    font-size: 18px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/BarlowCondensed-Bold.ttf");
    white-space: normal;
}

.rb-stat { flex-direction: column; margin-right: 18px; }
.rb-stat__label { font-size: 11px; color: var(--color-text-muted); letter-spacing: 0.6px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/BarlowCondensed-SemiBold.ttf"); }
.rb-stat__line { flex-direction: row; align-items: center; }
.rb-stat__value { font-size: 22px; -unity-font-definition: url("project://database/Assets/UI/Fonts/BarlowCondensed-Bold.ttf"); margin-right: 4px; }

.rb-line { flex-direction: row; align-items: center; min-height: 24px; }
.rb-line__label { width: 120px; flex-shrink: 0; margin-right: 8px; color: var(--color-text-muted); font-size: 13px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rb-line__value { flex-shrink: 1; font-size: 13px; white-space: normal; margin-right: 4px; }

.rb-badge { margin-right: 6px; }
.rb-chips { flex-wrap: wrap; margin-bottom: 6px; }
.rb-chips > .choice-chip { flex-grow: 0; min-width: 0; margin: 0 6px 6px 0; padding: 4px 10px; min-height: 28px; }
.rb-chips .choice-chip__label { font-size: 13px; }
.rb-chips .choice-chip__detail { font-size: 11px; }

/* Tables (UNITY-13): one line per cell, a steady row height, columns that keep a minimum width.
   Cells never wrap their pieces (number + Why?, push + Set, portrait + name); long text ends in
   an ellipsis instead of pushing into the next cell. Opt back into wrapping with .t-wrap. */
.rb-table { flex-direction: column; flex-shrink: 0; border-width: 1px; border-color: var(--color-border); border-radius: 6px; margin-bottom: 12px; }
.rb-table__row { flex-direction: row; align-items: center; flex-shrink: 0; min-height: 38px; padding: 2px 10px; border-bottom-width: 1px; border-color: var(--color-border); }
.rb-table__row:hover { background-color: var(--color-surface-hover); }
.rb-table__head { background-color: var(--color-surface-raised); min-height: 28px; }
.rb-table__head:hover { background-color: var(--color-surface-raised); }
.rb-table__cell { flex-direction: row; align-items: center; flex-shrink: 1; overflow: hidden; padding-right: 8px; }
.rb-table__cell .rb-row { flex-wrap: nowrap; flex-shrink: 1; min-width: 0; }
.rb-table__cell .rb-cell-stack { flex-shrink: 1; min-width: 0; overflow: hidden; }
.rb-table__cell .unity-label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex-shrink: 1; min-width: 0; }
.rb-table__cell .t-wrap { white-space: normal; }
/* Headings are short and measured without their letter spacing: never truncate them. */
.rb-table__head .unity-label { flex-shrink: 0; overflow: visible; text-overflow: clip; }
.rb-table__cell Button { flex-shrink: 0; }
.rb-table__cell .rb-portrait { margin-right: 8px; }
.rb-table__heading { font-size: 11px; color: var(--color-text-muted); letter-spacing: 0.6px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/BarlowCondensed-SemiBold.ttf"); }
.rb-table__text { font-size: 13px; }
.rb-table .btn--link { font-size: 12px; min-height: 18px; }

/* Office. */
.rb-kpis { flex-direction: row; flex-wrap: wrap; margin-bottom: 4px; }
.rb-kpi { padding: 8px 12px; margin: 0 10px 10px 0; min-width: 170px; flex-grow: 1; }
.rb-story { flex-direction: column; padding: 6px 0; }
.rb-story__date { margin-left: 6px; }

/* Calendar. */
.rb-toolbar { margin-bottom: 8px; }
.rb-toolbar__title { min-width: 180px; -unity-text-align: middle-center; }
.rb-month { flex-direction: column; border-width: 1px; border-color: var(--color-border); border-radius: 6px; }
.rb-month__week { flex-direction: row; }
.rb-month__cell { flex-grow: 1; flex-basis: 0; min-height: 92px; padding: 4px; border-right-width: 1px; border-bottom-width: 1px; border-color: var(--color-border); overflow: hidden; }
.rb-month__cell--head { min-height: 24px; }
.rb-month__cell--outside { opacity: 0.45; }
.rb-month__cell--today { background-color: var(--color-surface-raised); border-color: var(--color-data); }
.rb-month__day { font-size: 12px; color: var(--color-text-muted); margin-bottom: 2px; }
.rb-show-chip { margin: 0 0 2px 0; padding: 1px 6px; min-height: 20px; border-width: 0; border-left-width: 3px; border-color: var(--color-border-strong);
    background-color: var(--color-surface-sunken); border-radius: 3px; justify-content: flex-start; }
.rb-show-chip:hover { background-color: var(--color-surface-hover); }
.rb-show-chip--own { border-color: var(--color-action-bright); }
.rb-show-chip--major { border-color: var(--color-prestige); }
.rb-show-chip--done { opacity: 0.7; }
.rb-show-chip__label { font-size: 11px; overflow: hidden; flex-grow: 1; flex-shrink: 1; -unity-text-align: middle-left; white-space: nowrap; text-overflow: ellipsis; }

/* Booking. */
.rb-show-picker { flex-direction: row; flex-wrap: wrap; margin-bottom: 8px; }
.rb-show-pick { flex-grow: 0; min-width: 0; margin: 0 6px 6px 0; padding: 4px 10px; flex-direction: column; align-items: flex-start; }
.rb-show-pick .choice-chip__label { font-size: 13px; }
.rb-show-pick { flex-direction: row; align-items: center; }
.rb-show-pick__text { flex-direction: column; align-items: flex-start; flex-shrink: 1; }
.rb-show-pick .choice-chip__label, .rb-show-pick .choice-chip__detail { -unity-text-align: middle-left; white-space: nowrap; }
.rb-showbar { flex-direction: row; align-items: center; padding: 10px 14px; margin-bottom: 10px; }
.rb-showbar__info { flex-grow: 1; flex-shrink: 1; flex-direction: column; }
.rb-showbar__actions > .btn { margin-left: 8px; margin-right: 0; min-height: 32px; font-size: 14px; }
.rb-broadcast { border-left-width: 4px; border-color: var(--color-action); }
.rb-scorebug { flex-wrap: nowrap; }
.rb-slot { flex-direction: row; padding: 6px 0; border-bottom-width: 1px; border-color: var(--color-border); min-height: 48px; }
.rb-slot__head { flex-direction: row; width: 190px; flex-shrink: 0; align-items: flex-start; }
.rb-slot__head > .rb-cell-stack { flex-grow: 1; }
.rb-slot__number { width: 26px; font-size: 20px; color: var(--color-text-subtle);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/BarlowCondensed-Bold.ttf"); }
.rb-slot__content { flex-grow: 1; flex-shrink: 1; flex-direction: column; }
.rb-slot__actions { margin-top: 2px; }
.rb-slot .btn--link { font-size: 12px; min-height: 18px; }
.rb-check { flex-direction: row; align-items: flex-start; padding: 3px 0; }
.rb-check__mark { width: 18px; font-size: 13px; }
.rb-controls { margin-bottom: 8px; }
.rb-controls > .btn { min-height: 32px; font-size: 14px; }

/* Show night. */
.rb-order-row { flex-direction: row; align-items: center; justify-content: flex-start; margin: 0 0 2px 0; padding: 4px 6px;
    border-width: 1px; border-color: transparent; background-color: transparent; border-radius: 4px; min-height: 30px; }
.rb-order-row:hover { background-color: var(--color-surface-hover); }
.rb-order-row--next { border-color: var(--color-action-bright); }
.rb-order-row--shown { background-color: var(--color-surface-raised); }
.rb-order-row__mark { width: 18px; color: var(--color-data); }
.rb-order-row > .rb-cell-stack { flex-grow: 1; }
.rb-report .rb-stat { margin-top: 6px; }

/* Segment editor and picker. */
.rb-editor { width: 560px; }
.rb-side { border-width: 1px; border-color: var(--color-border); border-radius: 6px; padding: 6px 8px; margin-bottom: 6px; }
.rb-side .btn--link { font-size: 12px; min-height: 18px; }
.rb-picker { width: 640px; height: 640px; }
.rb-picker__list { margin-top: 8px; }
.rb-pick-row { flex-direction: row; align-items: center; justify-content: flex-start; margin: 0; padding: 3px 8px; min-height: 30px;
    border-width: 0; border-bottom-width: 1px; border-color: var(--color-border); background-color: transparent; border-radius: 0; }
.rb-pick-row:hover { background-color: var(--color-surface-hover); }
.rb-pick-row { flex-shrink: 0; flex-wrap: nowrap; }
.rb-pick-row > .unity-label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-left; }
.rb-pick-row__name { width: 200px; flex-shrink: 1; min-width: 120px; font-size: 13px; }
.rb-pick-row__cell { width: 100px; flex-shrink: 0; }

/* New game wizard (UNITY-13): no absolute positioning; every row is a flex row that never
   shrinks below its content (Yoga shrinks children by default, which is what made the fields and
   choice buttons overlap when the step was taller than the window). The step scrolls instead. */
.rb-wizard { flex-direction: column; font-size: 14px; flex-shrink: 1; min-height: 0; }
.rb-wizard > * { flex-shrink: 0; }
.rb-wizard__steps { flex-direction: row; margin-bottom: 12px; }
.rb-wizard__step { margin-right: 14px; color: var(--color-text-subtle); font-size: 13px; }
.rb-wizard__step--current { color: var(--color-text); -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-Bold.ttf"); }
.rb-wizard > .rb-wizard__body { flex-grow: 0; flex-shrink: 1; min-height: 0; }
.rb-wizard__body .unity-scroll-view__content-container { padding-right: 14px; }
.rb-wizard__body .unity-scroll-view__content-container > * { flex-shrink: 0; }
.rb-wizard__nav { flex-direction: row; margin-top: 14px; padding-top: 12px; border-top-width: 1px; border-color: var(--color-border); }
.rb-wizard__nav > .btn { margin-right: 8px; min-width: 110px; }
.rb-wizard__section {
    margin-top: 22px; margin-bottom: 8px; padding-bottom: 4px;
    border-bottom-width: 1px; border-color: var(--color-border);
    font-size: 13px; letter-spacing: 1.2px; color: var(--color-text-muted);
    -unity-font-definition: url("project://database/Assets/UI/Fonts/BarlowCondensed-Bold.ttf");
}
.rb-wizard__section--first { margin-top: 0; }
.rb-wizard__advanced-toggle { align-self: flex-start; margin-top: 22px; }
.rb-wizard__advanced { flex-direction: column; margin-top: 8px; }

/* World, promotion and workshop mod choices: full-width option cards, text left-aligned and wrapping. */
.rb-option { flex-direction: column; align-items: stretch; flex-shrink: 0; flex-grow: 0; margin: 0 0 6px 0; padding: 8px 12px; min-height: 0; min-width: 0; }
.rb-option .choice-chip__label, .rb-option .choice-chip__detail { -unity-text-align: middle-left; white-space: normal; }
.rb-option .choice-chip__detail { margin-top: 2px; }
.rb-option--with-logo { flex-direction: row; align-items: center; }
.rb-option__text { flex-direction: column; flex-grow: 1; flex-shrink: 1; min-width: 0; }
.choice-chip--selected .rb-option__text > .choice-chip__label { color: var(--color-data); }
.rb-world-list, .rb-promo-list, .rb-mod-list, .rb-import-warnings { flex-direction: column; flex-shrink: 0; }
.rb-import-progress { margin-top: 10px; color: var(--color-text-subtle); }

/* Two-column form: label left, field right, fixed row height. */
.rb-form { flex-direction: column; flex-shrink: 0; }
.rb-form__row { flex-direction: row; align-items: center; flex-shrink: 0; min-height: 48px; margin-bottom: 8px; }
.rb-form__label { width: 140px; flex-shrink: 0; color: var(--color-text-muted); font-size: 14px; -unity-text-align: middle-left; }
.rb-form__field { flex-grow: 1; flex-shrink: 1; min-width: 160px; max-width: 420px; height: 40px; }
.rb-form__field > .unity-base-text-field__input { height: 40px; min-height: 40px; -unity-text-align: middle-left; }
.rb-form__action { margin-left: 10px; flex-shrink: 0; min-height: 40px; }
.rb-form__hint { margin-left: 140px; margin-top: -4px; margin-bottom: 6px; color: var(--color-text-muted); font-size: 12px; white-space: normal; }

/* Segmented choices (setting values, season length): one line of equal-height buttons. */
.rb-segmented { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; margin-bottom: 4px; }
.rb-segmented > .choice-chip { flex-grow: 0; flex-shrink: 0; min-width: 72px; min-height: 34px; margin: 0 6px 6px 0; padding: 4px 14px; }
.rb-segmented .choice-chip__label { font-size: 15px; white-space: nowrap; }

/* A setting: name and description on the left, choices on the right, vertically centred. */
.rb-setting { flex-direction: row; align-items: center; flex-shrink: 0; padding: 8px 0; border-bottom-width: 1px; border-color: var(--color-border); min-height: 52px; }
.rb-setting__text { flex-direction: column; flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 200px; margin-right: 20px; }
.rb-setting__name { font-size: 14px; white-space: normal; -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold.ttf"); }
.rb-setting__description { margin-top: 2px; font-size: 12px; color: var(--color-text-muted); white-space: normal; }
.rb-setting__choices { flex-wrap: nowrap; flex-grow: 0; flex-shrink: 0; margin-bottom: 0; }
.rb-setting__choices > .choice-chip { margin-bottom: 0; }

/* The cash chip's Why? button. */
.status-chip__why { margin-left: 4px; }
.rb-order-row .unity-label { -unity-text-align: middle-left; }
.rb-order-row > .rb-cell-stack { align-items: flex-start; }
.rb-portrait { width: 32px; height: 32px; min-width: 32px; min-height: 32px; flex-shrink: 0; flex-grow: 0; border-radius: 4px; margin-right: 6px; }

/* Promotion logos (UNITY-13): a fixed box, the picture fitted inside with its aspect ratio kept,
   the monogram only when there is no picture. */
.rb-logo { flex-shrink: 0; flex-grow: 0; align-items: center; justify-content: center; overflow: hidden;
    border-width: 1px; border-color: var(--color-border-strong); border-radius: 6px; background-color: var(--color-surface-hover); margin-right: 12px; }
.rb-logo--picture { background-color: transparent; border-color: transparent; }
.rb-logo--sm { width: 24px; height: 24px; min-width: 24px; margin-right: 6px; }
.rb-logo--md { width: 36px; height: 36px; min-width: 36px; }
.rb-logo--lg { width: 52px; height: 52px; min-width: 52px; }
.rb-logo__image { width: 100%; height: 100%; }
.rb-logo__monogram { color: var(--color-prestige); -unity-text-align: middle-center; font-size: 15px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/BarlowCondensed-ExtraBold.ttf"); }
.rb-logo--sm .rb-logo__monogram { font-size: 10px; }
.rb-logo--lg .rb-logo__monogram { font-size: 20px; }
.rb-identity { flex-direction: row; align-items: center; }
.rb-identity > .rb-note { flex-shrink: 1; }
.rb-logo-slot { flex-direction: row; flex-shrink: 0; }
.rb-logo--xl { width: 72px; height: 72px; min-width: 72px; }
.rb-logo--xl .rb-logo__monogram { font-size: 26px; }
#show-sheet-logo { margin-bottom: 10px; }
.rb-show-title { margin-bottom: 4px; }
.rb-show-title > .rb-title { flex-shrink: 1; }
.rb-show-chip { flex-direction: row; align-items: center; }
.rb-show-chip__icon { width: 14px; height: 14px; min-width: 14px; flex-shrink: 0; margin-right: 4px; }

/* Founding your own promotion (UNITY-20): colour swatches and the logo preview. */
.rb-found-colours { flex-shrink: 0; margin-bottom: 6px; }
.rb-swatch { width: 34px; height: 34px; min-width: 34px; margin: 0 8px 6px 0; padding: 0; border-width: 2px; border-color: transparent; border-radius: 6px; }
.rb-swatch--selected { border-color: #f1f5f9; }
.rb-found-preview { align-items: center; flex-shrink: 0; margin: 4px 0 8px 0; }
.rb-found-preview__name { margin-left: 12px; }
