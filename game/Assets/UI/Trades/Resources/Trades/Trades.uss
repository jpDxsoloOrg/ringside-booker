/*
 * The trade sheet and the Contracts › Trades tab (TRD-02). The look comes from the UNITY-11 ds-
 * components and the contract sheet's ct- classes; tr- classes only place things. Loaded at run
 * time by TradeSheet.Style (Resources "Trades/Trades"). Rows never shrink (UNITY-13 layout rule);
 * ellipsized labels keep letter-spacing 0.
 */

.tr-sheet {
    flex-shrink: 0;
}

.tr-sheet .ds-section-header {
    margin-top: 12px;
    margin-bottom: 6px;
}

.tr-footer > .ds-btn {
    margin-left: 8px;
}

/* ---- Rival ----------------------------------------------------------------------------------------- */

.tr-rival {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 10px;
}

.tr-rival__words {
    margin-left: 12px;
    flex-shrink: 1;
}

.tr-rival__words > .ct-field__label {
    margin-bottom: 2px;
}

.tr-rival__name {
    font-size: 18px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/BarlowCondensed-Bold.ttf");
    color: var(--ds-text);
}

/* ---- The read and the problems ------------------------------------------------------------------- */

.tr-read {
    margin-bottom: 4px;
}

.tr-problems {
    flex-shrink: 0;
}

.tr-problem {
    flex-shrink: 0;
    margin-top: 8px;
    padding: 7px 10px;
    border-radius: var(--ds-radius-sm);
    background-color: var(--ds-state-soft);
}

.tr-problem__line {
    flex-direction: row;
    align-items: flex-start;
}

.tr-problem__line > .ct-notice__icon {
    margin-top: 1px;
}

.tr-problem__fix {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 4px;
    margin-left: 24px;
}

.tr-problem__fix-text {
    flex-shrink: 1;
    margin-right: 8px;
    font-size: 12px;
    color: var(--ds-text-2);
    white-space: normal;
}

/* ---- Sides --------------------------------------------------------------------------------------- */

.tr-columns {
    flex-shrink: 0;
    margin-top: 4px;
}

.tr-side {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    padding: 4px 12px 12px 12px;
    border-width: 1px;
    border-color: var(--ds-line);
    border-radius: var(--ds-radius-md);
    background-color: var(--ds-elev-1);
}

.tr-side--give {
    margin-right: 12px;
}

.tr-side > .ds-btn--ghost {
    margin-top: 6px;
    align-self: flex-start;
}

.tr-side__empty {
    margin-top: 2px;
}

.tr-worker {
    flex-shrink: 0;
    margin-top: 8px;
    padding: 8px 10px;
    border-width: 1px;
    border-color: var(--ds-line-subtle);
    border-radius: var(--ds-radius-sm);
    background-color: var(--ds-elev-0);
}

.tr-worker__top {
    flex-direction: row;
    align-items: center;
}

.tr-worker__words {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 10px;
}

.tr-worker__name-row {
    flex-direction: row;
    align-items: center;
}

.tr-worker__name-row > .ds-tag,
.tr-worker__name-row > .ct-name-cell__crown {
    margin-left: 6px;
    flex-shrink: 0;
}

.tr-worker__name {
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: 0;
    font-size: 14px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold.ttf");
    color: var(--ds-text);
}

.tr-worker__facts {
    margin-top: 2px;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: 0;
    font-size: 12px;
    color: var(--ds-text-3);
}

.tr-worker__say {
    flex-shrink: 0;
}

.tr-worker__change {
    margin-top: 4px;
    font-size: 12px;
    color: var(--ds-data);
    white-space: normal;
}

.tr-worker__more {
    margin-top: 4px;
    align-self: flex-start;
}

.tr-terms {
    margin-top: 2px;
}

.tr-say {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 6px;
}

.tr-say > .ds-dot {
    flex-shrink: 1;
}

.tr-say > .ds-dot > Label {
    white-space: normal;
}

.tr-say__morale {
    margin-left: 8px;
    font-size: 12px;
    color: var(--ds-text-3);
}

.tr-say > .why-button {
    margin-left: 6px;
}

.tr-cash-line {
    margin-top: 10px;
    font-size: 13px;
    color: var(--ds-text);
}

/* ---- Picker -------------------------------------------------------------------------------------- */

.tr-picker {
    width: 380px;
    padding: 8px;
}

.tr-picker__scroll {
    max-height: 360px;
    margin-top: 6px;
}

.tr-picker__row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: auto;
    min-height: 40px;
    margin: 0 0 2px 0;
    padding: 4px 8px;
    border-width: 0;
    border-radius: var(--ds-radius-sm);
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-left;
}

.tr-picker__row:hover {
    background-color: var(--ds-elev-2);
}

.tr-picker__words {
    flex-grow: 1;
    min-width: 0;
}

.tr-picker__top {
    flex-direction: row;
    align-items: center;
}

.tr-picker__top > .ds-tag {
    margin-left: 6px;
}

.tr-picker__name {
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: 0;
    font-size: 13px;
    -unity-text-align: middle-left;
    color: var(--ds-text);
}

.tr-picker__facts,
.tr-picker__blocked {
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: 0;
    font-size: 11px;
    -unity-text-align: middle-left;
    color: var(--ds-text-3);
}

.tr-picker__blocked {
    color: var(--ds-text-4);
}

/* ---- A trade ------------------------------------------------------------------------------------- */

.tr-banner {
    align-items: flex-start;
    margin-top: 0;
    margin-bottom: 8px;
}

.tr-banner__words {
    flex-grow: 1;
    flex-shrink: 1;
}

.tr-banner__title {
    font-size: 14px;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/Inter-SemiBold.ttf");
    color: var(--ds-text);
}

.tr-banner__next {
    margin-top: 2px;
    font-size: 12px;
    color: var(--ds-text-2);
}

.tr-moves {
    flex-shrink: 0;
    margin-top: 4px;
}

.tr-move {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 30px;
    border-bottom-width: 1px;
    border-bottom-color: var(--ds-line-subtle);
}

.tr-move__icon {
    margin-right: 8px;
    color: var(--ds-good);
}

.tr-move__text {
    flex-shrink: 1;
    font-size: 13px;
    color: var(--ds-text);
}

/* ---- Contracts › Trades tab ---------------------------------------------------------------------- */

.tr-rival-cell {
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.tr-rival-cell > .ds-cell__text {
    margin-left: 8px;
    flex-shrink: 1;
}
